# ---- Web server ----
PORT=3000
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
COOKIE_SECURE=false            # set true behind HTTPS in production
PUBLIC_URL=http://localhost:3000
DB_PATH=./data/veridoc.db

# ---- First super-admin (created on first start if no users exist) ----
SUPER_ADMIN_EMAIL=admin@veridoc.local
SUPER_ADMIN_PASSWORD=ChangeMe!12345

# ---- Blockchain ----
# Local dev: RPC from `npm run chain`; keys are Hardhat's public test keys (NEVER use on mainnet).
CHAIN_RPC_URL=http://127.0.0.1:8545
CONTRACT_ADDRESS=              # filled by deploy script; also read from deployments/<network>.json
# Owner key: registers/suspends institutions. Relayer key: signs issue/revoke transactions.
OWNER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
RELAYER_PRIVATE_KEY=0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d
# Etherscan base used for transaction links in the UI
EXPLORER_TX_URL=https://sepolia.etherscan.io/tx/

# ---- Sepolia deployment (hardhat) ----
SEPOLIA_RPC_URL=
DEPLOYER_PRIVATE_KEY=
